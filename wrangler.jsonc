{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "standup-helper",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "OPENROUTER_MODEL": "openrouter/free",
    "PUBLIC_APP_URL": "https://standup-helper.mykhailo-zubkov.workers.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_SYNC",
        "class_name": "RoomSync"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-room-sync",
      "new_sqlite_classes": ["RoomSync"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "standup-helper-db",
      "database_id": "3d61cc48-be51-4e31-8e6f-4c3365ecdbf0",
      "migrations_dir": "migrations"
    }
  ]
}
