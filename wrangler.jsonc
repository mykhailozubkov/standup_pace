{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "standup-helper",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "OPENROUTER_MODEL": "dots-studio/dots-3-note-preview:free",
    "PUBLIC_APP_URL": "https://standup-helper.mykhailo-zubkov.workers.dev"
  }
}
